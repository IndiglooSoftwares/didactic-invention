# LLM provider settings
LLM_PROVIDER=openai          # openai | anthropic | ollama | custom
LLM_MODEL=gpt-4o             # Model name (provider-specific)
LLM_API_KEY=sk-...           # Your API key
LLM_BASE_URL=                # Optional: override base URL (e.g. for proxies)
LLM_TEMP=0.7                 # Sampling temperature (0.0–2.0)
LLM_MAX_TOKENS=2048          # Max tokens per response
LLM_STREAM=false             # Enable streaming responses (true/false)

# Mentor settings
MAX_HISTORY=20               # Sliding window of messages to keep in memory
SESSION_FILE=                # Optional: path to a JSON file for session persistence
                             # e.g. SESSION_FILE=./data/session.json

# Logging
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
